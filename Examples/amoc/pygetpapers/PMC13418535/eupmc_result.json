ext": "0000-0003-3949-6560"}, "authorAffiliationDetailsList": {"authorAffiliation": {"affiliation": "College of Marine Science, University of South Florida, St. Petersburg, FL, USA."}}}, {"fullName": "Li Y", "firstName": "Yun", "lastName": "Li", "initials": "Y", "authorId": {"@type": "ORCID", "#text": "0000-0002-4766-4723"}, "authorAffiliationDetailsList": {"authorAffiliation": {"affiliation": "School of Marine Science and Policy, University of Delaware, Lewes, DE, USA."}}}, {"fullName": "Neukermans G", "firstName": "Griet", "lastName": "Neukermans", "initials": "G", "authorId": {"@type": "ORCID", "#text": "0000-0002-8258-3590"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Ghent University, Faculty of Sciences, Biology Department, MarSens Research Group, Ghent, Belgium."}, {"affiliation": "Flanders Marine Institute (VLIZ), Ostend, Belgium."}]}}, {"fullName": "Liu X", "firstName": "Xin", "lastName": "Liu", "initials": "X", "authorId": {"@type": "ORCID", "#text": "0000-0002-7925-9618"}, "authorAffiliationDetailsList": {"authorAffiliation": {"affiliation": "State Key Laboratory of Marine Environmental Science, Xiamen University, Xiamen, China."}}}, {"fullName": "Zheng Y", "firstName": "Yan", "lastName": "Zheng", "initials": "Y", "authorId": {"@type": "ORCID", "#text": "0000-0001-5256-9395"}, "authorAffiliationDetailsList": {"authorAffiliation": {"affiliation": "School of Environmental Science and Engineering, Southern University of Science and Technology, Shenzhen, China."}}}, {"fullName": "Zheng C", "firstName": "Chunmiao", "lastName": "Zheng", "initials": "C", "authorId": {"@type": "ORCID", "#text": "0000-0001-5839-1305"}, "authorAffiliationDetailsList": {"authorAffiliation": {"affiliation": "School of the Environment and Sustainable Engineering, Eastern Institute of Technology, Ningbo, China."}}}]}, "authorIdList": {"authorId": [{"@type": "ORCID", "#text": "0000-0001-5256-9395"}, {"@type": "ORCID", "#text": "0000-0001-5839-1305"}, {"@type": "ORCID", "#text": "0000-0002-3983-6388"}, {"@type": "ORCID", "#text": "0000-0002-4590-3022"}, {"@type": "ORCID", "#text": "0000-0002-4766-4723"}, {"@type": "ORCID", "#text": "0000-0002-7925-9618"}, {"@type": "ORCID", "#text": "0000-0002-8258-3590"}, {"@type": "ORCID", "#text": "0000-0003-3949-6560"}, {"@type": "ORCID", "#text": "0009-0007-2463-7742"}]}, "journalInfo": {"issue": "31", "volume": "12", "journalIssueId": "4235121", "dateOfPublication": "2026 Jul", "monthOfPublication": "7", "yearOfPublication": "2026", "printPublicationDate": "2026-07-01", "journal": {"title": "Science advances", "ISOAbbreviation": "Sci Adv", "medlineAbbreviation": "Sci Adv", "NLMid": "101653440", "ISSN": "2375-2548", "ESSN": "2375-2548"}}, "pubYear": "2026", "pageInfo": "eadw5268", "abstractText": "Coccolithophores are vital to marine ecosystems and play a central role in the global carbon cycle. Although abundant in the temperate North Atlantic and Barents Sea, their long-term bloom dynamics remain poorly understood. Using two decades of satellite observations, we reveal a substantial decline in coccolithophore blooms between 2003 and 2022, with a 36.1% reduction in bloom area and a 51.2% decrease in bloom frequency. The decline is most pronounced in the temperate North Atlantic and western Barents Sea, while the eastern Barents Sea shows notable increases. Decreasing sea surface temperatures (SSTs) in the North Atlantic and warming in the eastern Barents Sea are identified as key drivers of these trends. However, SST changes alone do not explain the asymmetric patterns across the Barents Sea, suggesting additional environmental drivers and phytoplankton competition. Our study provides the most spatially and temporally resolved assessment of coccolithophore bloom trends in this region to date, with broader implications for marine ecosystems and carbon cycling.", "affiliation": "School of Environmental Science and Engineering, Southern University of Science and Technology, Shenzhen,