-0002-3660-8160"}, {"@type": "ORCID", "#text": "0000-0002-3746-4517"}, {"@type": "ORCID", "#text": "0000-0002-4869-8052"}, {"@type": "ORCID", "#text": "0000-0002-5941-7770"}, {"@type": "ORCID", "#text": "0000-0002-8609-6204"}, {"@type": "ORCID", "#text": "0000-0002-9873-3338"}, {"@type": "ORCID", "#text": "0000-0002-9878-3247"}, {"@type": "ORCID", "#text": "0000-0003-0122-3292"}, {"@type": "ORCID", "#text": "0000-0003-0529-4020"}, {"@type": "ORCID", "#text": "0000-0003-0601-8888"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "17", "journalIssueId": "4138066", "dateOfPublication": "2026 Mar", "monthOfPublication": "3", "yearOfPublication": "2026", "printPublicationDate": "2026-03-01", "journal": {"title": "Nature communications", "ISOAbbreviation": "Nat Commun", "medlineAbbreviation": "Nat Commun", "NLMid": "101528555", "ISSN": "2041-1723", "ESSN": "2041-1723"}}, "pubYear": "2026", "pageInfo": "2704", "abstractText": "Projections of biodiversity futures are needed to translate global policies into national action. We use dissimilarity modelling to project climate change scenarios for 1002 plant, 56 butterfly, and 219 bird species across Great Britain up to 2080. Under all scenarios we find extensive community reorganisation, with the disappearance of current bioclimates and emergence of novel ones. We also explore impacts of combined climate and land-use change, finding that even optimistic scenarios could see accumulating extinction debts. Scenarios featuring reduced emissions and a more sustainable society could bend the curve of loss, reducing species heading for extinction by 32% for plants, 14% for butterflies, and 20% for birds. Scenarios differ in impact between groups, with plants showing the most severe responses to environmental change. Overall, we show that actions taken during the next 20 years are crucial to mitigate the worst effects of climate and land-use change for biodiversity in Britain.", "affiliation": "UK Centre for Ecology & Hydrology, Maclean Building, Crowmarsh Gifford, Wallingford, UK. roboke@ceh.ac.uk.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"grantId": "NE/R016429/1", "agency": "RCUK | Natural Environment Research Council", "orderIn": "0"}, {"grantId": "NE/V006800/1", "agency": "RCUK | Natural Environment Research Council", "orderIn": "0"}, {"agency": "Helmholtz Association", "orderIn": "0"}, {"grantId": "NE/R016429/1", "agency": "RCUK | Natural Environment Research Council (NERC)", "orderIn": "0"}, {"grantId": "NE/V007548/1", "agency": "RCUK | Natural Environment Research Council", "orderIn": "0"}, {"grantId": "NE/V007548/1", "agency": "RCUK | Natural Environment Research Council (NERC)", "orderIn": "0"}, {"grantId": "NE/V006800/1", "agency": "RCUK | Natural Environment Research Council (NERC)", "orderIn": "0"}, {"grantId": "817946", "agency": "EC | Horizon 2020 Framework Programme", "orderIn": "0"}, {"grantId": "817946", "agency": "EC | Horizon 2020 Framework Programme (EU Framework Programme for Research and Innovation H2020)", "orderIn": "0"}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Birds", "meshQualifierList": {"meshQualifier": {"abbreviation": "PH", "qualifierName": "physiology", "majorTopic_YN": "N"}}}, {"majorTopic_YN": "N", "descriptorName": "Butterflies", "meshQualifierList": {"meshQualifier": {"abbreviation": "PH", "qualifierName": "physiology", "majorTopic_YN": "N"}}}, {"majorTopic_YN": "N", "descriptorName": "Plants"}, {"majorTopic_YN": "Y", "descriptorName": "Conservation of Natural Resources"}, {"majorTopic_YN": "N", "descriptorName": "Ecosystem"}, {"majorTopic_YN": "Y", "descriptorName": "Biodiversity"}, {"majorTopic_YN": "N", "descriptorName": "Extinction, Biological"}, {"majorTopic_YN": "Y